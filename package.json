{
  "name": "ledgernepal",
  "private": true,
  "description": "LedgerNepal — multi-tenant digital bahi-khata for Nepali businesses",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspaces --if-present",
    "db:check": "npm run db:check --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:migrate:down": "npm run db:migrate:down --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:status": "npm run db:status --workspace server"
  }
}
