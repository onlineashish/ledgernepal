{
  "name": "ledgernepal",
  "private": true,
  "description": "LedgerNepal — multi-tenant digital bahi-khata for Nepali businesses",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspaces --if-present",
    "db:check": "npm run db:check --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:migrate:down": "npm run db:migrate:down --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:status": "npm run db:status --workspace server",
    "build": "npm run build --workspace client"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
