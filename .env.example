# Copy to .env and fill in real values. This file is committed; .env is not.

NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173

# Neon pooled connection string (host contains "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Neon direct connection string (same, without "-pooler") — used for migrations
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Separate Neon branch used only by automated tests (data is wiped)
TEST_DATABASE_URL=

# Email is OPTIONAL. Without it, "Forgot password" cannot send mail, but an owner/admin can still
# create a reset link for a team member from the Team page, and invitations never use email.
# Development default: console (prints the email, including the link, in the server log).
# Production default: none. To send real mail through Brevo (works on Render, needs no domain):
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-...           (Brevo: SMTP & API > API Keys)
# MAIL_FROM_EMAIL=you@example.com     (a sender address you verified in Brevo: Senders, Domains & IPs > Senders)
# MAIL_FROM_NAME=LedgerNepal
