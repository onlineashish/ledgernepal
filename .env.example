# Copy to .env and fill in real values. This file is committed; .env is not.

NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173

# Neon pooled connection string (host contains "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon direct connection string (same, without "-pooler") — used for migrations
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Separate Neon branch used only by automated tests (data is wiped)
TEST_DATABASE_URL=
